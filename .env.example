# ─────────────────────────────────────────────────────────────
# 리포트 포털 환경변수 목록 (변수명만 적는다. 실제 값은 절대 넣지 말 것)
# 실제 값은 각 PC의 .env.local (Git·공유 드라이브에 올리지 않음)
# 또는 Vercel / Supabase 비밀값 저장소에만 등록한다.
# ─────────────────────────────────────────────────────────────

# Supabase 프로젝트 주소와 공개 키 (브라우저에 노출되어도 되는 값, 접근 통제는 RLS가 담당)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 웹 서버(Vercel) 전용. NEXT_PUBLIC_ 접두어를 절대 붙이지 말 것
SUPABASE_SERVICE_ROLE_KEY=

# 주의: 아래 값들은 이 파일이나 .env.local에 두지 않는다.
# - ENCRYPTION_KEY (광고주 API 키 암호화 마스터키): `supabase secrets set` 으로 수집 작업에만 등록
# - 네이버 검색광고 CUSTOMER_ID / 액세스라이선스 / 비밀키: 관리자 화면에서 입력 → DB에 암호화 저장
