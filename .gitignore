# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 변수명만 적은 예시 파일은 커밋한다 (실제 값은 절대 넣지 않는다)
!.env.example

# supabase 로컬 작업 파일
supabase/.temp/
supabase/.branches/

# 비밀값·인증서 류
*.key
*.p12
secrets/

# 업로드용 임시 폴더
.tmp-upload/
